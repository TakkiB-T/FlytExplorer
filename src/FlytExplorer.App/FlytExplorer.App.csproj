<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FlytExplorer.App</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>FlytExplorer.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged deployment — no MSIX; bootstrapper auto-initialises via NuGet targets.
         RuntimeIdentifier is intentionally omitted for dev builds: the win-x64 RID apphost
         embeds a native bootstrapper that crashes with E_INVALIDARG before .NET starts.
         Use `dotnet publish -r win-x64` for release packaging. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlytExplorer.Core\FlytExplorer.Core.csproj" />
    <ProjectReference Include="..\FlytExplorer.FileSystem\FlytExplorer.FileSystem.csproj" />
    <ProjectReference Include="..\FlytExplorer.Search\FlytExplorer.Search.csproj" />
    <ProjectReference Include="..\FlytExplorer.Shell\FlytExplorer.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="FlytExplorer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\lib\Everything\Everything64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- dotnet publish does not copy WinUI 3 compiled XAML (.xbf) or resource index (.pri).
       Copy them from the RID build output so the published exe can load XAML at runtime. -->
  <Target Name="CopyWinUIResourcesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResources Include="$(OutDir)**\*.xbf" />
      <_WinUIResources Include="$(OutDir)*.pri" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Themes" />
    <Copy SourceFiles="@(_WinUIResources)"
          DestinationFolder="$(PublishDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
