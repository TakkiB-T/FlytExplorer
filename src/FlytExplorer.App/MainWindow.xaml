<Window
    x:Class="FlytExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FlytExplorer.App"
    mc:Ignorable="d"
    Title="Flyt Explorer">

    <Grid Background="{ThemeResource NordicBackgroundBrush}">
        <Grid.Resources>

            <local:KindToForegroundConverter x:Key="KindToForeground" />
            <local:HexColorToBrushConverter x:Key="HexToBrush" />

            <Style x:Key="FileListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Minimize / Maximize button -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#2A3C48" />
                                                <Setter Target="Glyph.Foreground" Value="#D4E2E0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#334856" />
                                                <Setter Target="Glyph.Foreground" Value="#D4E2E0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#5C8896"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Close button (danger hover) -->
            <Style x:Key="TitleBarCloseStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#C85050" />
                                                <Setter Target="Glyph.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#A34040" />
                                                <Setter Target="Glyph.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#5C8896"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar navigation item -->
            <Style x:Key="SidebarNavStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="6,1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource NordicHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource NordicSelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Padding="8,6"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalContentAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat square TabViewItem: replaces WinUI 3 rounded/connector default template -->
            <Style x:Key="FlatTabStyle" TargetType="TabViewItem">
                <Setter Property="IsTabStop"  Value="False" />
                <Setter Property="MinWidth"   Value="80" />
                <Setter Property="MaxWidth"   Value="200" />
                <Setter Property="Height"     Value="36" />
                <Setter Property="Padding"    Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <Grid x:Name="RootGrid"
                                  Background="{ThemeResource TabViewItemHeaderBackground}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"   Value="{ThemeResource TabViewItemHeaderBackgroundPointerOver}" />
                                                <Setter Target="HeaderLabel.Foreground" Value="{ThemeResource TabViewItemHeaderForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"   Value="{ThemeResource TabViewItemHeaderBackgroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"    Value="{ThemeResource TabViewItemHeaderBackgroundSelected}" />
                                                <Setter Target="HeaderLabel.Foreground" Value="{ThemeResource TabViewItemHeaderForegroundSelected}" />
                                                <Setter Target="Pipe.Opacity"           Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"    Value="{ThemeResource TabViewItemHeaderBackgroundSelected}" />
                                                <Setter Target="HeaderLabel.Foreground" Value="{ThemeResource TabViewItemHeaderForegroundSelected}" />
                                                <Setter Target="Pipe.Opacity"           Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"    Value="{ThemeResource TabViewItemHeaderBackgroundSelected}" />
                                                <Setter Target="HeaderLabel.Foreground" Value="{ThemeResource TabViewItemHeaderForegroundSelected}" />
                                                <Setter Target="Pipe.Opacity"           Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- Accent line at top (visible when selected) -->
                                <Border x:Name="Pipe"
                                        Height="2"
                                        VerticalAlignment="Top"
                                        Opacity="0"
                                        Background="{ThemeResource TabViewItemHeaderBorderBrushSelected}" />

                                <!-- Header text + close button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="HeaderLabel"
                                               Grid.Column="0"
                                               Margin="12,0,4,0"
                                               Text="{TemplateBinding Header}"
                                               Foreground="{ThemeResource TabViewItemHeaderForeground}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Named "CloseButton" so TabViewItem code-behind manages visibility -->
                                    <Button x:Name="CloseButton"
                                            Grid.Column="1"
                                            Width="18" Height="18"
                                            Margin="2,0,6,0"
                                            Padding="0"
                                            CornerRadius="2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="8"
                                                  Foreground="{ThemeResource TabViewItemHeaderCloseButtonForeground}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- File-entry DataTemplate shared across all tab ListViews (browse mode) -->
            <DataTemplate x:Key="FileEntryTemplate">
                <Grid Padding="8,4" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <!-- Icon column: glyph always present; thumbnail overlays it when loaded -->
                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Image Source="{Binding ThumbnailBitmap}"
                               Width="28" Height="28"
                               Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding SizeDisplay}"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource NordicTextMutedBrush}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding DateModifiedDisplay}"
                               Foreground="{ThemeResource NordicTextMutedBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12" />
                </Grid>
            </DataTemplate>

            <!-- Search-result DataTemplate — adds parent path column -->
            <DataTemplate x:Key="SearchEntryTemplate">
                <Grid Padding="8,4" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Image Source="{Binding ThumbnailBitmap}"
                               Width="28" Height="28"
                               Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding ParentPath}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource NordicTextMutedBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SizeDisplay}"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource NordicTextMutedBrush}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding DateModifiedDisplay}"
                               Foreground="{ThemeResource NordicTextMutedBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12" />
                </Grid>
            </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="6" />    <!-- Drag strip (invisible, window move area) -->
            <RowDefinition Height="52" />   <!-- Toolbar + caption buttons -->
            <RowDefinition Height="*" />    <!-- File list -->
            <RowDefinition Height="28" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Drag strip (invisible, same bg as toolbar) ── -->
        <Border x:Name="DragStrip"
                Grid.Row="0"
                Background="{ThemeResource NordicSidebarBrush}" />

        <!-- ── Row 1: Toolbar — same background as tab strip so they read as one chrome band -->
        <Grid x:Name="ToolbarGrid"
              Grid.Row="1"
              Background="{ThemeResource NordicSidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- Nav buttons -->
                <ColumnDefinition Width="*" />      <!-- Address bar (drag area) -->
                <ColumnDefinition Width="220" />    <!-- Search box -->
                <ColumnDefinition Width="138" />    <!-- Caption buttons (3 × 46) -->
            </Grid.ColumnDefinitions>

            <!-- Navigation buttons -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Padding="6,0,4,0">
                <Button x:Name="BackButton"    Tag="&#xE72B;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="BackButton_Click" ToolTipService.ToolTip="Back"
                        AutomationProperties.Name="戻る" />
                <Button x:Name="ForwardButton" Tag="&#xE72A;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward"
                        AutomationProperties.Name="進む" />
                <Button x:Name="UpButton"      Tag="&#xE74A;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="UpButton_Click" ToolTipService.ToolTip="Up"
                        AutomationProperties.Name="上のフォルダー" />
                <Button x:Name="RefreshButton" Tag="&#xE72C;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="更新" />
            </StackPanel>

            <!-- Address bar (also acts as drag region via SetTitleBar on ToolbarGrid) -->
            <TextBox x:Name="AddressBox"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     Background="{ThemeResource NordicSidebarBrush}"
                     Foreground="{ThemeResource NordicTextPrimaryBrush}"
                     BorderBrush="{ThemeResource NordicDividerBrush}"
                     FontFamily="Segoe UI Variable"
                     AutomationProperties.Name="アドレスバー"
                     KeyDown="AddressBox_KeyDown" />

            <!-- Search area: scope badge + search box -->
            <Grid Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Scope toggle badge -->
                <Border Grid.Column="0"
                        Background="{ThemeResource NordicHoverBrush}"
                        CornerRadius="4"
                        Margin="0,0,3,0"
                        Padding="0">
                    <Button x:Name="SearchScopeBadge"
                            Content="すべて"
                            FontSize="11"
                            Height="26"
                            Padding="7,2"
                            Background="Transparent"
                            Foreground="{ThemeResource NordicTextMutedBrush}"
                            BorderThickness="0"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="検索スコープを切り替え (Ctrl+K=全体 / Ctrl+F=フォルダ)"
                            AutomationProperties.Name="検索スコープ切り替え"
                            Click="SearchScopeBadge_Click" />
                </Border>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         PlaceholderText="検索 (Ctrl+K)"
                         VerticalAlignment="Center"
                         Background="{ThemeResource NordicSidebarBrush}"
                         Foreground="{ThemeResource NordicTextPrimaryBrush}"
                         BorderBrush="{ThemeResource NordicDividerBrush}"
                         FontFamily="Segoe UI Variable"
                         AutomationProperties.Name="ファイルを検索"
                         TextChanged="SearchBox_TextChanged" />
            </Grid>

            <!-- Toolbar bottom border — hidden because toolbar and tab strip share the same background -->
            <Border Grid.Column="0" Grid.ColumnSpan="4"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{ThemeResource NordicSidebarBrush}" />

            <!-- Caption buttons (rightmost, same height as toolbar) -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch">

                <Button x:Name="MinimizeButton"
                        Tag="&#xE921;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="46" Height="52"
                        Click="MinimizeButton_Click"
                        ToolTipService.ToolTip="Minimize"
                        AutomationProperties.Name="最小化" />

                <Button x:Name="MaximizeButton"
                        Tag="&#xE922;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="46" Height="52"
                        Click="MaximizeButton_Click"
                        ToolTipService.ToolTip="Maximize"
                        AutomationProperties.Name="最大化" />

                <Button x:Name="CloseButton"
                        Tag="&#xE8BB;"
                        Style="{StaticResource TitleBarCloseStyle}"
                        Width="46" Height="52"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close"
                        AutomationProperties.Name="閉じる" />
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Sidebar + File list ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Grid Grid.Column="0" Background="{ThemeResource NordicSidebarBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,10,0,10">

                        <TextBlock Text="QUICK ACCESS"
                                   Foreground="{ThemeResource NordicTextMutedBrush}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,4" />

                        <Button Tag="{x:Bind _homeDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Home" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _desktopDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Desktop" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _documentsDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Documents" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _downloadsDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Downloads" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource NordicDividerBrush}"
                                Margin="10,8" />

                        <TextBlock Text="THIS PC"
                                   Foreground="{ThemeResource NordicTextMutedBrush}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,4" />

                        <Button Tag="C:\"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local Disk (C:)" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource NordicDividerBrush}"
                                Margin="10,8" />

                        <TextBlock Text="NETWORK"
                                   Foreground="{ThemeResource NordicTextMutedBrush}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,4" />

                        <Button Style="{StaticResource SidebarNavStyle}"
                                Click="NetworkNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Network path…" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{ThemeResource NordicTextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{ThemeResource NordicDividerBrush}" />

            <!-- Per-tab file browser — content (ListView, ProgressRing) built in code-behind -->
            <TabView x:Name="MainTabView"
                     Grid.Column="2"
                     Background="{ThemeResource NordicBackgroundBrush}"
                     TabWidthMode="SizeToContent"
                     AutomationProperties.Name="ファイルブラウザー"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     SelectionChanged="MainTabView_SelectionChanged" />
        </Grid>

        <!-- ── Row 3: Status bar ── -->
        <Grid Grid.Row="3" Background="{ThemeResource NordicSurfaceBrush}" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource NordicTextMutedBrush}"
                       FontFamily="Segoe UI Variable"
                       FontSize="12" />

            <!-- Search pagination (visible only in search mode) -->
            <StackPanel x:Name="SearchPagination"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="8,0">
                <Button x:Name="SearchPrevButton"
                        Content="‹"
                        FontSize="14"
                        Width="24" Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="False"
                        Click="SearchPrevButton_Click" />
                <TextBlock x:Name="SearchPageLabel"
                           Text="1 / 1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource NordicTextMutedBrush}"
                           FontFamily="Segoe UI Variable"
                           FontSize="12" />
                <Button x:Name="SearchNextButton"
                        Content="›"
                        FontSize="14"
                        Width="24" Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="False"
                        Click="SearchNextButton_Click" />
            </StackPanel>

            <TextBlock x:Name="SelectionText"
                       Grid.Column="2"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource NordicAccentBrush}"
                       FontFamily="Segoe UI Variable"
                       FontSize="12"
                       Margin="0,0,4,0" />
        </Grid>
    </Grid>

</Window>
