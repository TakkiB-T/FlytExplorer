<Window
    x:Class="FlytExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FlytExplorer.App"
    mc:Ignorable="d"
    Title="Flyt Explorer">

    <Grid Background="{StaticResource NordicBackgroundBrush}">
        <Grid.Resources>

            <local:KindToForegroundConverter x:Key="KindToForeground" />

            <Style x:Key="FileListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Minimize / Maximize button -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#2A3C48" />
                                                <Setter Target="Glyph.Foreground" Value="#D4E2E0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#334856" />
                                                <Setter Target="Glyph.Foreground" Value="#D4E2E0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#5C8896"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Close button (danger hover) -->
            <Style x:Key="TitleBarCloseStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#C85050" />
                                                <Setter Target="Glyph.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#A34040" />
                                                <Setter Target="Glyph.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#5C8896"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar navigation item -->
            <Style x:Key="SidebarNavStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="6,1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource NordicHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource NordicSelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Padding="8,6"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalContentAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="6" />    <!-- Drag strip (invisible, window move area) -->
            <RowDefinition Height="52" />   <!-- Toolbar + caption buttons -->
            <RowDefinition Height="*" />    <!-- File list -->
            <RowDefinition Height="28" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Drag strip (invisible, same bg as toolbar) ── -->
        <Border x:Name="DragStrip"
                Grid.Row="0"
                Background="{StaticResource NordicSurfaceBrush}" />

        <!-- ── Row 1: Toolbar ── -->
        <Grid x:Name="ToolbarGrid"
              Grid.Row="1"
              Background="{StaticResource NordicSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- Nav buttons -->
                <ColumnDefinition Width="*" />      <!-- Address bar (drag area) -->
                <ColumnDefinition Width="220" />    <!-- Search box -->
                <ColumnDefinition Width="138" />    <!-- Caption buttons (3 × 46) -->
            </Grid.ColumnDefinitions>

            <!-- Navigation buttons -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Padding="6,0,4,0">
                <Button x:Name="BackButton"    Tag="&#xE72B;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="BackButton_Click" ToolTipService.ToolTip="Back" />
                <Button x:Name="ForwardButton" Tag="&#xE72A;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward" />
                <Button x:Name="UpButton"      Tag="&#xE74A;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="UpButton_Click" ToolTipService.ToolTip="Up" />
                <Button x:Name="RefreshButton" Tag="&#xE72C;" Style="{StaticResource TitleBarButtonStyle}"
                        Width="36" Height="36" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh" />
            </StackPanel>

            <!-- Address bar (also acts as drag region via SetTitleBar on ToolbarGrid) -->
            <TextBox x:Name="AddressBox"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     Background="{StaticResource NordicSidebarBrush}"
                     Foreground="{StaticResource NordicTextPrimaryBrush}"
                     BorderBrush="{StaticResource NordicDividerBrush}"
                     FontFamily="Segoe UI Variable"
                     KeyDown="AddressBox_KeyDown" />

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     PlaceholderText="Search (Ctrl+K)"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0"
                     Background="{StaticResource NordicSidebarBrush}"
                     Foreground="{StaticResource NordicTextPrimaryBrush}"
                     BorderBrush="{StaticResource NordicDividerBrush}"
                     FontFamily="Segoe UI Variable"
                     TextChanged="SearchBox_TextChanged" />

            <!-- Toolbar bottom border -->
            <Border Grid.Column="0" Grid.ColumnSpan="4"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{StaticResource NordicDividerBrush}" />

            <!-- Caption buttons (rightmost, same height as toolbar) -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch">

                <Button x:Name="MinimizeButton"
                        Tag="&#xE921;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="46" Height="52"
                        Click="MinimizeButton_Click"
                        ToolTipService.ToolTip="Minimize" />

                <Button x:Name="MaximizeButton"
                        Tag="&#xE922;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="46" Height="52"
                        Click="MaximizeButton_Click"
                        ToolTipService.ToolTip="Maximize" />

                <Button x:Name="CloseButton"
                        Tag="&#xE8BB;"
                        Style="{StaticResource TitleBarCloseStyle}"
                        Width="46" Height="52"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Sidebar + File list ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Grid Grid.Column="0" Background="{StaticResource NordicSidebarBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,10,0,10">

                        <TextBlock Text="QUICK ACCESS"
                                   Foreground="{StaticResource NordicTextMutedBrush}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,4" />

                        <Button Tag="{x:Bind _homeDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Home" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{StaticResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _desktopDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Desktop" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{StaticResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _documentsDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Documents" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{StaticResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Tag="{x:Bind _downloadsDir}"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Downloads" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{StaticResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource NordicDividerBrush}"
                                Margin="10,8" />

                        <TextBlock Text="THIS PC"
                                   Foreground="{StaticResource NordicTextMutedBrush}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,4" />

                        <Button Tag="C:\"
                                Style="{StaticResource SidebarNavStyle}"
                                Click="SidebarNav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource NordicAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local Disk (C:)" FontFamily="Segoe UI Variable" FontSize="13"
                                           Foreground="{StaticResource NordicTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{StaticResource NordicDividerBrush}" />

            <!-- Main file list -->
            <Grid Grid.Column="2">
                <ProgressRing x:Name="LoadingRing"
                              IsActive="False"
                              Width="48" Height="48"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{StaticResource NordicAccentBrush}" />

                <TextBlock x:Name="EmptyMessage"
                           Text="This folder is empty"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource NordicTextMutedBrush}"
                           FontFamily="Segoe UI Variable" />

                <ListView x:Name="FileListView"
                          Background="Transparent"
                          SelectionMode="Extended"
                          FontFamily="Segoe UI Variable"
                          Foreground="{StaticResource NordicTextPrimaryBrush}"
                          ItemContainerStyle="{StaticResource FileListItemStyle}"
                          DoubleTapped="FileListView_DoubleTapped"
                          SelectionChanged="FileListView_SelectionChanged"
                          KeyDown="FileListView_KeyDown"
                          RightTapped="FileListView_RightTapped">
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="ListContextMenu" Opening="ListContextMenu_Opening">
                            <MenuFlyoutItem x:Name="MenuOpen"   Text="開く"         Click="MenuOpen_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuRename" Text="名前の変更 (F2)" Click="MenuRename_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuCopy"   Text="コピー (Ctrl+C)" Click="MenuCopy_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuCut"    Text="切り取り (Ctrl+X)" Click="MenuCut_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuPaste"  Text="貼り付け (Ctrl+V)" Click="MenuPaste_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuDelete" Text="削除 (Del)"  Click="MenuDelete_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuNewFolder" Text="新規フォルダ (Ctrl+Shift+N)" Click="MenuNewFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.Header>
                        <Grid Background="{StaticResource NordicSurfaceBrush}" Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Name"
                                       Foreground="{StaticResource NordicTextMutedBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Size"
                                       Foreground="{StaticResource NordicTextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Date modified"
                                       Foreground="{StaticResource NordicTextMutedBrush}"
                                       Margin="8,0,0,0"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4" MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding KindGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{Binding Kind, Converter={StaticResource KindToForeground}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontSize="13" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeDisplay}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource NordicTextMutedBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding DateModifiedDisplay}"
                                           Foreground="{StaticResource NordicTextMutedBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ── Row 3: Status bar ── -->
        <Grid Grid.Row="3" Background="{StaticResource NordicSurfaceBrush}" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource NordicTextMutedBrush}"
                       FontFamily="Segoe UI Variable"
                       FontSize="12" />
            <TextBlock x:Name="SelectionText"
                       Grid.Column="1"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource NordicAccentBrush}"
                       FontFamily="Segoe UI Variable"
                       FontSize="12"
                       Margin="0,0,4,0" />
        </Grid>
    </Grid>

</Window>
